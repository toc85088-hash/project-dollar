# Brand and canonical origin. Leave blank until the owner approves real values.
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Local editorial preview only. Drafts remain unavailable when launch mode is enabled.
NEXT_PUBLIC_SHOW_DRAFTS=false

# Explicit launch gate. Do not set true before the deployment checklist is complete.
SITE_LAUNCH_READY=false
CONTENT_LAUNCH_APPROVED=false
TRUST_PAGES_APPROVED=false

# Google values must come from the owner's real properties. No tags or ads are installed yet.
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
